{
  "name": "cartwright",
  "version": "0.46.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:agent": "node scripts/dev-agent.mjs",
    "build": "prisma generate && pnpm build:registry && pnpm gen:manifest && next build",
    "build:registry": "tsx scripts/build-registry-source.ts",
    "gen:manifest": "tsx scripts/gen-marketplace-manifests.ts",
    "gen:scaffold-manifest": "tsx scripts/gen-scaffold-manifest.ts",
    "audit:site-profile": "tsx scripts/site-profile-audit.ts",
    "db:push": "prisma db push",
    "db:verify": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "admin:reset": "tsx scripts/admin-reset.ts",
    "admin:create": "tsx scripts/admin-reset.ts --create",
    "embeddings:backfill": "tsx scripts/backfill-embeddings.ts",
    "pgvector:setup": "tsx scripts/pgvector-setup.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:native": "tsgo --noEmit",
    "i18n:pull": "i18nexus pull",
    "test": "vitest run",
    "verify:deploy": "bash scripts/verify-deploy.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "capture:gallery": "node scripts/capture-gallery.mjs",
    "dev:screenshot": "node scripts/dev-screenshot.mjs",
    "verify:design": "node scripts/dev-screenshot.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.33",
    "@ai-sdk/google": "^4.0.36",
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@ai-sdk/react": "^4.0.58",
    "@auth/prisma-adapter": "^2.11.3",
    "@google/genai": "^2.16.0",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.69.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.13.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.7.0",
    "ai": "^7.0.55",
    "bcryptjs": "^3.0.3",
    "botid": "^1.5.11",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "js-yaml": "^4.3.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "v0-sdk": "^0.16.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@typescript-eslint/parser": "8.66.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.9.0",
    "i18nexus-cli": "^5.1.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
