    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "^6.16.0",
    "server-only": "^0.0.1",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0",
    "v0-sdk": "^0.16.4",
    "zod": "^4.4.3"
