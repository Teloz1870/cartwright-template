    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@typescript-eslint/parser": "8.62.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "fast-check": "^4.8.0",
    "i18nexus-cli": "^5.1.1",
