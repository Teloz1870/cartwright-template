# SQLite database (file path relative to prisma/)
DATABASE_URL="file:./dev.db"

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET="replace-me-with-a-random-string"

# Anthropic API key for the storefront AI assistant (/api/assistant/chat).
# Without this, the endpoint returns 503 and the chat window shows a friendly error.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Unsplash API key for image search from admin chat (images.search_unsplash).
# Without this, the AI cannot suggest images for new products.
# Get a free dev key at https://unsplash.com/oauth/applications (50 req/hour)
UNSPLASH_ACCESS_KEY=""

# Phase 4: Stripe (real payment via webhook). Set via /admin/integrations
# instead of env if you prefer database-backed config.
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Phase 4: Resend email service (replaces PreviewMailer in production).
# RESEND_API_KEY=""

# Phase 4: Sentry error tracking (critical for production). No-op without DSN.
# Server-side DSN (private):
# SENTRY_DSN=""
# Client-side DSN (public, bundled in JS):
# NEXT_PUBLIC_SENTRY_DSN=""
# Build-time source map upload (set in Vercel project env, not locally).
# Generate token at https://sentry.io/settings/auth-tokens/ with scopes
# project:releases + org:read.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Phase 4: Vercel Cron auth-secret for /api/cron/reconcile-stripe.
# Generate with: openssl rand -hex 32
# CRON_SECRET=""

# Phase 11: Upstash Redis Rate Limiting. Required to rate-limit /api endpoints.
# Create a free Redis database at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
