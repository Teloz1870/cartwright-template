# --- Database ---------------------------------------------------------------
# Lokal udvikling: SQLite-fil (file path relative to prisma/). KUN til dev.
DATABASE_URL="file:./dev.db"

# PRODUCTION: sæt Turso (libSQL) — en managed, server-baseret, skalerbar
# SQLite-kompatibel DB. Uden disse NÆGTER appen at starte i production
# (NODE_ENV=production), så du ikke ved et uheld sender rigtige kunder ind på en
# ephemeral fil-DB der mister data ved hvert deploy. Opret med:
#   turso db create <din-shop>-db && turso db tokens create <din-shop>-db
# Se DEPLOY.md §2. (Bevidst self-host på persistent volume: ALLOW_SQLITE_IN_PRODUCTION=1)
# TURSO_DATABASE_URL="libsql://<din-shop>-db.turso.io"
# TURSO_AUTH_TOKEN=""

# Auth.js — generate a secret with: npx auth secret
AUTH_SECRET="replace-me-with-a-random-string"

# Canonical site URL for Auth.js callback/redirect URLs. The engine sets
# trustHost:true so self-hosted prod (next start / Docker / non-Vercel) works
# out of the box — but in production you should ALSO pin AUTH_URL to your real
# origin so a spoofed Host header can't redirect auth flows. On Vercel this is
# auto-detected and can be left unset. Example: https://shop.example.com
# AUTH_URL="https://your-domain.com"

# Admin start-password (seed). If set, `prisma db seed` creates the admin with
# THIS password. If UNSET, the seed generates a strong random password, prints it
# ONCE in the seed output, and forces a change on first admin login (/admin/konto).
# There is never a hardcoded default. Set this to pick your own, or leave it unset.
# ADMIN_PASSWORD="choose-a-strong-admin-password"

# Demo-only: admin password used by the /api/admin/reset-demo-data endpoint on the
# demo canaries. Set per demo deploy for a known demo login; unset = a random one
# is generated (password-login then needs this env, or use magic-link).
# DEMO_ADMIN_PASSWORD=""

# Anthropic API key for the storefront AI assistant (/api/assistant/chat).
# Without this, the endpoint returns 503 and the chat window shows a friendly error.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Unsplash API key for image search from admin chat (images.search_unsplash).
# Without this, the AI cannot suggest images for new products.
# Get a free dev key at https://unsplash.com/oauth/applications (50 req/hour)
UNSPLASH_ACCESS_KEY=""

# Phase 4: Stripe (real payment via webhook). Set via /admin/integrations
# instead of env if you prefer database-backed config.
# Uden keys = mock-checkout (ingen rigtige penge). Test-keys (sk_test_…) =
# Stripe test-mode. Før du tager imod RIGTIGE betalinger skal du bruge
# LIVE-keys (sk_live_…) fra en aktiveret Stripe-konto. Se DEPLOY.md §5.
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Phase 4: Resend email service (replaces PreviewMailer in production).
# RESEND_API_KEY=""

# Phase 4: Sentry error tracking (critical for production). No-op without DSN.
# Server-side DSN (private):
# SENTRY_DSN=""
# Client-side DSN (public, bundled in JS):
# NEXT_PUBLIC_SENTRY_DSN=""
# Build-time source map upload (set in Vercel project env, not locally).
# Generate token at https://sentry.io/settings/auth-tokens/ with scopes
# project:releases + org:read.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Phase 4: Vercel Cron auth-secret for /api/cron/reconcile-stripe.
# Generate with: openssl rand -hex 32
# CRON_SECRET=""

# Phase 11: Upstash Redis Rate Limiting. Required to rate-limit /api endpoints.
# Create a free Redis database at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Phase 10: Google Search Console verification meta-tag content value.
# Værdien fra <meta name="google-site-verification" content="...">. Sættes
# i Search Console under "URL prefix property → HTML tag verification method".
# GOOGLE_SITE_VERIFICATION=""

# Phase 10: Google Analytics 4 measurement ID. Format G-XXXXXXXXXX.
# Scriptet loades KUN efter kunden har accepteret analytics-cookies via
# consent-banneret (Google Consent Mode v2 — anonymous pings indtil consent).
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=""

# Phase 10: Gemini-API-key til auto-genereret alt-text/SEO/GEO-metadata på
# uploads. Cron'en /api/cron/media-ai bruger samme key som /admin/integrations
# admin-DB-value — env-fallback når DB-key ikke er sat.
# GOOGLE_GEMINI_API_KEY=""

# Phase 10 Slice 7c: dato (ISO) fra hvilken post-purchase review-prompts sendes.
# Beskytter historik mod at få "tak for dit køb" emails på gamle ordrer ved
# første aktivering. Sæt til deploy-tidspunkt da reviews-flag flippes til true.
# Format: "2026-05-25T00:00:00Z". Ikke sat = cron'en no-op'er (sikker default).
# REVIEW_PROMPTS_FROM=""

# ── v0.10.0 -----------------------------------------------------------------
# Firecrawl: web-scraping API. Driver produkt-scraperen (/admin/produkter/scrape,
# Track F), design-importeren (/admin/design-import, Track I) OG Hoptify's ægte
# "importér fra Shopify" (/admin/hoptify). Uden key falder de tre tilbage til
# manuel/demo-mode. Få en key på https://www.firecrawl.dev/
# FIRECRAWL_API_KEY=""

# Vercel Blob read/write token. Bruges af Hoptify logo-generatoren
# (/admin/indstillinger → "Generér med Gemini") til at uploade det genererede
# raster-logo. Genereres i Vercel-dashboardet → Storage → Blob → Tokens.
# (På Vercel sættes den typisk automatisk når et Blob-store er linket.)
# BLOB_READ_WRITE_TOKEN=""

# "Sign in with GitHub" (features.githubAuth). Valgfri OAuth-login ved siden af
# magic-link. Opret en OAuth App på https://github.com/settings/developers med
# callback https://<dit-domæne>/api/auth/callback/github, og sæt flaget true i
# brand.config.ts. Knappen vises kun når BÅDE flaget OG begge keys er sat.
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# NB om genbrugte keys i v0.10.0:
# - GOOGLE_GEMINI_API_KEY (ovenfor): driver nu OGSÅ Hoptify logo-generatoren
#   (gemini-2.5-flash-image), ud over media-AI + voice.
# - CRON_SECRET (ovenfor): gater nu OGSÅ /api/cron/{backup,abandoned-cart,
#   cleanup-expired-tokens,audit-retention,seo-snapshot} — ikke kun stripe-reconcile.
# - UPSTASH_REDIS_* (ovenfor): bruges nu OGSÅ af Track H admin-redirects (proxy-cache).
# - Stripe Tax (features.stripeTax) + Google Search Console-OAuth (SEO Autopilot)
#   konfigureres via /admin/integrations (DB), ikke via env.
