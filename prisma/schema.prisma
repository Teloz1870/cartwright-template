// ============================================================================
// Master Plan §4 Phase 5 — A2A (Agent-to-Agent) data foundation.
//
// Four greenfield models that make the Headless Merchant architecture possible:
//
//   AgentCard         — signed JSON blob a buyer agent reads to discover this
//                       shop's capabilities, payment rails, and negotiation policy.
//   EscrowTransaction — state machine for the Verify-then-Pay (TessPay) flow.
//                       Funds held in escrow at checkout, released on PoTE.
//   PoTEProof         — Proof-of-Task-Execution. Cryptographic evidence that
//                       authorises fund release from EscrowTransaction.
//   AgenticJWT        — A-JWT audit log row. Every agentic call writes one;
//                       Guardian middleware (Phase 7) consults these for
//                       legislation enforcement + replay protection.
//
// All four are gated behind brand.features.a2a (default false). Teloz keeps
// the flag off — the models exist in every fork's DB but no endpoint reads
// them unless the fork opts in.
// ============================================================================

// Signed JSON-LD blob a buyer agent reads to discover this shop's catalogue,
// payment rails (rails: ["stripe", "manual"]), negotiation policy floors, and
// trust anchors (public key for verifying responses from the shop).
//
// Cards are versioned + signed. We keep the latest active one + history (for
// audit) by sorting on createdAt DESC and filtering revokedAt IS NULL.
model AgentCard {
  id         String    @id @default(cuid())
  version    Int       @default(1) // monotonically increasing
  signedJson String // canonicalised JSON (the blob a buyer agent receives)
  signature  String // ed25519 signature over signedJson, base64
  publicKey  String // ed25519 public key, base64 (for buyer-side verification)
  signedAt   DateTime  @default(now())
  expiresAt  DateTime? // optional — null = no expiry
  revokedAt  DateTime? // null = active; non-null = card was rotated/revoked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([revokedAt, createdAt])
  @@index([version])
}

// State machine for the Verify-then-Pay flow.
//
// status transitions (enforced in lib/escrow/state-machine.ts, Phase 5):
//   pending  → funded   (buyer agent deposits via Stripe / payment rail)
//   funded   → released (PoTE verified, funds sent to shop)
//   funded   → refunded (PoTE missing or invalid, funds returned to buyer)
//   funded   → disputed (human dispute opened — admin resolves via /admin/agentic)
//   disputed → released (admin force-release)
//   disputed → refunded (admin force-refund)
//
// All transitions are recorded as AgenticJWT audit rows.
model EscrowTransaction {
  id String @id @default(cuid())

  // Optional link to ACP checkout session (the original buyer-agent
  // checkout). Not all escrows have one — agent-marketplace shops can
  // hold escrow without an ACP session.
  sessionId String?

  // Counterparty identification. agentId is the buyer-side principal
  // (typically the sub claim from their A-JWT).
  buyerAgentId String
  shopId       String? // null for default single-shop deployments

  // Amount in shop's minor currency unit (øre/cents). Matches Order.totalDkk.
  amountMinor Int
  currency    String @default("DKK")

  status        String    @default("pending") // pending | funded | released | refunded | disputed
  disputeReason String? // free-text, set when status → disputed
  fundedAt      DateTime?
  releasedAt    DateTime?
  refundedAt    DateTime?
  disputedAt    DateTime?

  // External payment-rail reference (e.g. Stripe PaymentIntent id)
  paymentRail  String  @default("stripe")
  paymentRefId String? // rail-specific id

  proofs PoTEProof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([buyerAgentId])
  @@index([sessionId])
  @@index([createdAt])
}

// Proof-of-Task-Execution — the cryptographic evidence that authorises
// fund release from an EscrowTransaction. proofType discriminates the
// verifier path:
//
//   "delivery"  — carrier-side delivery confirmation (signed webhook)
//   "signature" — buyer's signature over the delivered artifact hash
//   "hash"      — buyer submits a hash that matches the expected output
//   "webhook"   — external system (Stripe/shipping) confirmed via webhook
//
// verifierResult: "pass" → escrow can transition to released;
//                 "fail" → escrow can transition to refunded;
//                 "pending" → awaiting external verifier callback.
model PoTEProof {
  id         String            @id @default(cuid())
  escrowTxId String
  escrowTx   EscrowTransaction @relation(fields: [escrowTxId], references: [id], onDelete: Cascade)

  proofType        String // delivery | signature | hash | webhook
  proofPayloadJson String // proof-type-specific payload
  expectedHash     String? // for proofType=hash; pre-set at escrow funding
  submittedHash    String? // what was actually submitted

  verifierResult  String    @default("pending") // pending | pass | fail
  verifierMessage String? // free-text reason for fail / context for pass
  verifiedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escrowTxId])
  @@index([verifierResult])
}

// A-JWT audit log — every agentic call (auth, negotiate, escrow-verify, mcp)
// writes one row. Guardian middleware (Phase 7) reads these for:
//   - Replay protection (jti must be unique within issuer)
//   - Rate-limit aggregation per issuerAgentId
//   - Audit trail for the /admin/agentic dashboard (Phase 9)
//
// signedJwt is the raw A-JWT for forensic replay; capabilitiesJson is the
// parsed structured view (decision, price, reasoning_codes) the dashboard
// reads to avoid re-parsing the JWT every render.
model AgenticJWT {
  id String @id @default(cuid())

  // JWT claims (parsed)
  jti              String // unique per-issuer replay-protection id
  issuerAgentId    String // sub claim — the buyer agent
  audienceShop     String? // aud claim — null = default shop
  scopes           String // JSON-array of scope strings
  capabilitiesJson String // parsed {decision, price, reasoningCodes, ...}

  // Wire artefact (for forensic replay) — SQLite stores long strings as TEXT
  // automatically; no @db.Text directive needed (and not supported on sqlite).
  signedJwt String

  // Verification outcome
  verifyResult String  @default("pending") // pass | fail | pending | skipped
  verifyError  String? // free-text reason for fail/skipped

  // Request context
  requestPath   String // e.g. "/api/negotiate"
  requestMethod String // GET | POST | PUT | DELETE
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())

  @@unique([issuerAgentId, jti])
  @@index([issuerAgentId, createdAt])
  @@index([createdAt])
  @@index([verifyResult])
}

// ============================================================================
// Phase 10 — Compliance, Discovery & Media Intelligence.
//
// MediaAsset er det centrale media-bibliotek der konsolideres på tværs af alle
// upload-flader (Product gallery, Category.hero, Page.hero, Service.hero,
// BrandingSettings.hero). Erstatter på sigt de spredte string-URL-felter med
// FK-relationer, men kører additivt: legacy-URL-kolonner bevares så
// solbrillen-kanariet kan blive på gammel kode indtil mediaLibrary-flaget flippes.
//
// AI-felterne (alt*, title, caption, geoSnippet, dominantColors, suggestedSlug)
// udfyldes asynkront af /api/cron/media-ai (Slice 2) via Gemini vision.
// aiStatus styrer cron-loopet: pending → ok | failed (op til 3 forsøg) | skipped.
// ============================================================================
model MediaAsset {
  id             String   @id @default(cuid())
  url            String
  mime           String
  sizeBytes      Int
  width          Int?
  height         Int?
  durationSec    Int?
  blobPathname   String?  @unique
  sha256         String?
  altDa          String?
  altEn          String?
  title          String?
  caption        String?
  geoSnippet     String?
  dominantColors String? // JSON-array af hex-koder
  suggestedSlug  String?
  aiStatus       String   @default("pending") // pending | ok | failed | skipped
  aiModel        String?
  aiAttempts     Int      @default(0)
  aiLastError    String?
  uploadedBy     String? // typed prefix ("admin:<email>" | "system")
  driveFileId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productMedia  ProductMedia[]
  categoryHero  Category[]         @relation("CategoryHero")
  categoryVideo Category[]         @relation("CategoryVideo")
  pageHero      Page[]             @relation("PageHero")
  serviceHero   Service[]          @relation("ServiceHero")
  brandingHero  BrandingSettings[] @relation("BrandingHero")

  @@index([sha256])
  @@index([driveFileId])
  @@index([aiStatus, createdAt])
}

// Join-tabel for Product → MediaAsset (ordered gallery). position styrer
// rækkefølge i PDP-galleri; role tillader skelnen mellem gallery/hero/swatch
// uden separate tabeller.
model ProductMedia {
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id])
  position  Int        @default(0)
  role      String     @default("gallery") // gallery | hero | swatch

  @@id([productId, assetId])
  @@index([productId, position])
}

// ============================================================================
// Phase 10 Slice 7 — kunde-reviews.
//
// Workflow:
//   1. Kunde modtager post-purchase email (Slice 7c cron) med token-link
//      ELLER logger ind og går til /konto/ordrer/[id]/anmeld.
//   2. Submit → POST /api/reviews → status="pending"
//   3. Admin moderation på /admin/anmeldelser → approve / reject / spam.
//   4. Approved reviews render på PDP + tæller i AggregateRating JSON-LD
//      (kun når count >= 3, Google's minimum).
//
// orderId-link bevares for verified-purchase-badge. authorName + authorEmail
// gemmes som snapshot så reviews er læselige selvom user/order slettes.
// reviewToken er unik så email-link kan landes uden auth.
// ============================================================================
model ProductReview {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id])
  authorName    String
  authorEmail   String
  rating        Int // 1-5
  title         String?
  body          String
  language      String    @default("da")
  status        String    @default("pending") // pending | approved | rejected | spam
  moderatorNote String?
  moderatedBy   String?
  moderatedAt   DateTime?
  reviewToken   String?   @unique // for unauth via email-link
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productId, status])
  @@index([status, createdAt])
  @@index([orderId])
}

// Idempotens-tabel for post-purchase review-prompt mails. orderId som PK
// så samme ordre aldrig får to prompts (matcher ProcessedWebhookEvent-pattern).
model ReviewPromptLog {
  orderId        String   @id
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sentAt         DateTime @default(now())
  emailMessageId String?
}

// ─── SEO/GEO Autopilot (Track K, Pro) ───────────────────────────────────────

// Søge-performance-snapshot (fra GSC e.l.). Time-series → trends.
model SeoSnapshot {
  id          String   @id @default(cuid())
  capturedAt  DateTime @default(now())
  source      String // "gsc" | "manual"
  page        String?
  query       String?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  position    Float?
  ctr         Float?

  @@index([capturedAt])
}

// GEO-snapshot: er brandet citeret i et AI-svar for en given prompt?
model GeoSnapshot {
  id         String   @id @default(cuid())
  capturedAt DateTime @default(now())
  engine     String // "in-house" | "perplexity" | …
  prompt     String
  cited      Boolean  @default(false)
  note       String?

  @@index([capturedAt])
}

// Selvforbedrings-eksperiment: en genome-felt-ændring med en baseline, der
// beholdes hvis metrikken forbedres — ellers reverteres. status: running →
// kept | reverted.
model SeoExperiment {
  id           String    @id @default(cuid())
  fieldKey     String
  beforeValue  String?
  afterValue   String
  baselineJson String
  status       String    @default("running")
  startedAt    DateTime  @default(now())
  evaluatedAt  DateTime?
  resultNote   String?

  @@index([status])
}

// Newsletter-tilmeldinger (double-opt-in). UI'et (NewsletterSignup) havde ingen
// backend — denne model + /api/newsletter/* gør den rigtig. token bruges til
// både confirm- og unsubscribe-links. Additivt.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("pending") // pending | confirmed | unsubscribed
  token          String    @unique
  source         String?
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
}

// GDPR sletteret (art. 17). Loggen over anonymiserings-requests. Selve
// anonymiseringen (lib/gdpr/erase.ts) er SOFT + eksplicit-typet + audited og
// udløses KUN af en admin — aldrig automatisk. summaryJson rummer counts pr.
// model af hvor mange rækker der blev anonymiseret/slettet.
model DataErasureRequest {
  id          String    @id @default(cuid())
  userId      String?
  email       String
  status      String    @default("pending") // pending | done | failed
  requestedBy String // audit-actor der udløste
  summaryJson String?
  errorMsg    String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([email])
}

// Blog-post. Egen model (ikke Page) så blog får blog-semantik: excerpt, author,
// published-state + publishedAt, tags. Body bruger samme lette markdown som Page
// (lib/content.ts: ## / > / **). `tags` er en JSON-streng (SQLite har ingen
// scalar-lists). translations som Page (da/en). Gated bag features.blog.
model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  body            String
  // Provenance for `body`: "text" (engine markdown, safe renderContentBlocks
  // path) is the only value we write. Null/absent ⇒ "text". Imported Google-Docs
  // content is stored as markdown, never raw HTML.
  bodyFormat      String?
  coverImage      String?
  author          String?
  status          String    @default("draft") // draft | published
  publishedAt     DateTime?
  tags            String? // JSON array of strings
  metaTitle       String?
  metaDescription String?
  translations    Json?
  vibeHtml        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
}

// ─── Shipping & fulfillment (Track G) ───────────────────────────────────────

// Shipping-zone = lande-gruppe. `countries` = JSON-array af ISO-3166-1 alpha-2.
model ShippingZone {
  id        String         @id @default(cuid())
  name      String
  countries String // JSON: ["DK","SE",...]
  rates     ShippingRate[]
  createdAt DateTime       @default(now())
}

// Rate i en zone. Pris i øre. Valgfri vægt-interval + fri-fragt-threshold.
// deliveryDaysMin/Max driver leveringstid-visning.
model ShippingRate {
  id               String       @id @default(cuid())
  zoneId           String
  zone             ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name             String
  feeDkk           Int
  freeThresholdDkk Int?
  minWeightGram    Int?
  maxWeightGram    Int?
  deliveryDaysMin  Int          @default(2)
  deliveryDaysMax  Int          @default(5)

  @@index([zoneId])
}

// Dropship-leverandør. mode: "manual" (pakkeseddel/CSV) | "email" (email +
// bekræft-link). API-mode er en senere per-leverandør-adapter.
model Supplier {
  id                String             @id @default(cuid())
  name              String
  email             String?
  mode              String             @default("manual") // manual | email
  products          Product[]
  fulfillmentOrders FulfillmentOrder[]
  createdAt         DateTime           @default(now())
}

// Fulfillment-ordre = den del af en ordre der routes til én leverandør.
// status: created → sent → acknowledged → shipped → done. token til bekræft-link.
model FulfillmentOrder {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status     String   @default("created")
  token      String   @unique
  lineJson   String // JSON-snapshot af de OrderItems der hører til denne leverandør
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([supplierId])
}

// Admin-styrede redirects (WooCommerce-paritet). fromPath unik; proxy.ts slår
// op i en Redis-cachet map (fail-soft). status 301/302. Additivt.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

// Anonym install-tæller for den offentlige komponent-registry (/api/registry).
// Én række pr. servet registry-item (section-key eller svg-<slug>) — KUN
// item-slug + count, aldrig IP/UA/visitor-data. Skrives kun når
// brand.features.registryStats er on (fire-and-forget upsert via
// lib/registry-stats.ts — blokerer aldrig registry-svaret). Aflæses på
// /admin/registry-stats. Kør `pnpm db:push` før flaget aktiveres.
model RegistryHit {
  item      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
