   */
  chromeJson String?

  /**
   * Resolvable Genome (kernel). JSON-blob med per-shop genome-state:
   *   { overrides: { "<field>": string },
   *     resolved:  { "<field>": { value: string, deps: string } },
   *     identity:  { "<anchor>": string } }
