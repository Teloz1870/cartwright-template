// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7: den Rust-frie `prisma-client`-generator (query-compiler)
  // erstatter `prisma-client-js`. `output` er påkrævet; genereres til
  // app/generated/prisma (gitignored). Driver-adapter (@prisma/adapter-libsql)
  // er nu påkrævet for ALLE forbindelser — også lokal SQLite. Se lib/db.ts.
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  // SQLite-provider er stadig korrekt — Turso er SQLite-compatible (libSQL).
  // Schema-syntax + queries virker uændret. Prisma 7: `url` må IKKE længere stå
  // her — CLI-forbindelsen (db push/migrate/studio) ligger i prisma.config.ts
  // (datasource.url), og runtime-queries går via adapter i lib/db.ts.
  provider = "sqlite"
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  vibeHtml    String?
  // Phase 8 Task B: per-kategori hero-image. URL (Unsplash/CDN) frem for fil-upload
  // for at undgå S3/R2-afhængighed. Fallback til CATEGORY_IMAGES[slug] hardcoded
  // mapping i lib/images.ts hvis null.
  heroImage   String?

  // Video Pilot: per-kategori hero-video (MP4 URL fra fx Pexels/Coverr/Mux).
  // Hvis sat: kategori-page renderer CategoryHeroVideo i hero-band med poster
  // fallback til heroImage. Hvis null: kun statisk Image (current behavior).
  // Performance-strategi: saveData-detection + crossfade fra poster + lazy load.
  heroVideo String?

  // Phase 10: MediaAsset-FK'er. Nullable + parallelle med legacy URL-felter
  // ovenfor. lib/media/shim.ts foretrækker disse når brand.features.mediaLibrary
  // er on, falder ellers tilbage til heroImage/heroVideo strengen.
  heroImageAssetId String?
  heroImageAsset   MediaAsset? @relation("CategoryHero", fields: [heroImageAssetId], references: [id])
  heroVideoAssetId String?
  heroVideoAsset   MediaAsset? @relation("CategoryVideo", fields: [heroVideoAssetId], references: [id])

  // SEO Task A: rich kategori-content for SEO + design. Alle nullable så
  // eksisterende kategorier rendere som før hvis felter ikke er udfyldt.
  // descriptionLong: 300-400 ord markdown-like (## h2). Rendered via
  //   renderContentBlocks() på kategori-siden under hero.
  // metaTitle/metaDescription: override for <title> + <meta> i generateMetadata
  //   (fallback til name + description hvis null).
  // faq: JSON-array af {q, a}-pairs (4-5 stk). Rendered som <details>
  //   + Schema.org FAQPage JSON-LD for Google rich snippets.
  // Genereres af admin manuelt ELLER via "✨ Generér SEO med AI"-knap
  //   (lib/ai/category-seo-generator.ts — brand-portable via brand.config).
  descriptionLong String?
  metaTitle       String?
  metaDescription String?
  faq             String?
  translations    Json?

  products Product[]
}

model Page {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  body             String
  // Provenance for `body`: "text" (engine markdown, safe renderContentBlocks path)
  // is the only value we ever write. Null/absent ⇒ treated as "text". Imported
  // Google-Docs content is stored as markdown, never raw HTML.
  bodyFormat       String?
  heroImage        String?
  // Phase 10: parallel MediaAsset-FK. lib/media/shim.ts foretrækker dette
  // når brand.features.mediaLibrary er on, ellers fallback til heroImage.
  heroImageAssetId String?
  heroImageAsset   MediaAsset? @relation("PageHero", fields: [heroImageAssetId], references: [id])
  metaTitle        String?
  metaDescription  String?
  showInNav        Boolean     @default(false)
  navOrder         Int         @default(0)
  translations     Json?
  updatedAt        DateTime    @updatedAt
  vibeHtml         String?
  // Visual Builder: godkendt section-tree (lib/builder/section-schema.ts).
  // Null ⇒ render falder tilbage til vibeHtml/body → canary-safe. Kun læst når
  // brand.features.visualBuilderEnabled er on.
  layoutJson       String?
}

model Service {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  shortDescription String?
  priceString      String?
  heroImage        String?
  // Phase 10: parallel MediaAsset-FK. lib/media/shim.ts foretrækker dette
  // når brand.features.mediaLibrary er on, ellers fallback til heroImage.
  heroImageAssetId String?
  heroImageAsset   MediaAsset? @relation("ServiceHero", fields: [heroImageAssetId], references: [id])
  features         Json? // Array af strings
  body             String
  vibeHtml         String?
  showInNav        Boolean     @default(false)
  navOrder         Int         @default(0)
  translations     Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Product {
  id                String            @id @default(cuid())
  sku               String?           @unique
  name              String
  slug              String            @unique
  description       String
  priceDkk          Int // pris i øre
  videoUrl          String? // URL til den genererede Cinematic Video
  videoGenerationId String? // Luma AI generation ID under polling
  images            String // JSON-array af billede-URLs
  stock             Int               @default(0)
  // P1.1: Optional siden non-eyewear shops (panel-hegn etc.) ikke har frame/lens/brand.
  // Lossless for eksisterende solbrillen-rows (ALTER COLUMN DROP NOT NULL).
  frameColor        String?
  lensColor         String?
  brand             String?
  featured          Boolean           @default(false)
  // Shop-Starter Task G: generic attributes for fork-shops (panel-hegn:
  // "højde", "bredde", "materiale"; landbrug: "vægt", "oprindelse"). JSON-blob
  // i SQLite. PDP-renderer prøver attributes først, fallback til frameColor/
  // lensColor. ProductForm har key/value-editor for nem admin-input.
  attributes        Json?
  // AEO (answer-first) produktindhold — gated på brand.features.aeoContent.
  // Nullable/additivt (lossless for eksisterende rows); render + JSON-LD + admin-UI
  // læser dem KUN når flaget er on. Spejler Category's faq/descriptionLong-mønster.
  answerSummary     String? // 1-2 sætningers svar-først-lead (vises øverst på PDP)
  faq               String? // JSON-array af {q,a} — samme shape som Category.faq → FAQPage JSON-LD
  useCases          Json? // [{title, description}] — scannbare use-case-sektioner
  comparisonFacts   Json? // { nøgle: værdi } differentiatorer
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  cartItems         CartItem[]
  orderItems        OrderItem[]
  variants          ProductVariant[]
  // Phase 10: ordered join til MediaAsset for produkt-galleri.
  // lib/media/shim.ts foretrækker denne når brand.features.mediaLibrary er on,
  // ellers fallback til den legacy images-JSON-array ovenfor.
  productMedia      ProductMedia[]
  // Phase 10 Slice 7: kunde-reviews. AggregateRating JSON-LD renderes på PDP
  // når count(status="approved") >= 3 (Google's published minimum).
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]
  translations      Json?
  // Shipping/fulfillment (Track G): vægt til vægt-baserede rater + valgfri
  // dropship-leverandør. Additivt nullable.
  weightGram        Int?
  supplierId        String?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id])
  // Google Sheets sync: stores the 1-based source row number as text so row
  // references survive sheet edits without constraining future formats.
  sheetRowRef       String?
  // AI-first: soft-delete så audit.revert kan hente produkter tilbage.
  // Læsning af produkter skal filtrere `deletedAt: null` med mindre eksplicit
  // anmodet (fx i admin-trash-view eller audit-revert-flow).
  deletedAt         DateTime?
  embedding         ProductEmbedding?
  vibeHtml          String?
  createdAt         DateTime          @default(now())

  @@index([deletedAt])
}

// Shop-Starter Task B: produkt-varianter for fork-shops (panel-hegn:
// dimensions × farve × pris; landbrug: vægt-trin × oprindelse).
// Solbriller bruger normalt ikke variants (frameColor/lensColor er
// pr. produkt) — feltet er nullable på CartItem/OrderItem så
// produkter UDEN varianter opfører sig præcis som før.
//
// SKU er unik PR PRODUKT (et produkt kan have "2x3-grey" + "2x3-black";
// to forskellige produkter kan begge bruge "2x3-grey" — ingen kollision).
// priceDkk holdes på varianten så forskellige dimensioner kan have
// forskellige priser; ProductCard viser "fra X kr" hvis min(variants) ≠ Product.priceDkk.
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String // unique-per-product (fx "panel-hegn-2x3-grey")
  priceDkk   Int // pris i øre — kan afvige fra Product.priceDkk
  stock      Int         @default(0)
  // Attribute-pairs der definerer varianten. Panel-hegn: {height: "2m", width: "3m", color: "grå"}
  // Vises på PDP som variant-picker (én dropdown pr. attribute-key).
  attributes Json
  createdAt  DateTime    @default(now())
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@index([productId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // passwordHash er optional fordi kunder kan have ren magic-link-konto
  // (Auth.js v5 EmailProvider). Bestående brugere beholder deres password;
  // nye magic-link-only konti har passwordHash: null.
  passwordHash  String?
  emailVerified DateTime? // Auth.js standard — sættes ved første verify
  // @default("") so the Auth.js PrismaAdapter can create magic-link/OAuth users
  // (it calls createUser with only { email, emailVerified } — no name). Without a
  // default this throws PrismaClientValidationError → /api/auth/error?error=Configuration
  // on the magic-link callback. Users set their name later in /account.
  name          String    @default("")
  role          String    @default("customer") // "customer" | "admin"
  // Sikkerhed: sat true når admin oprettes med et genereret/seedet password, så
  // admin tvinges til at skifte det ved første login (gate i app/admin/layout.tsx).
  mustChangePassword Boolean @default(false)

  // Phase 2: gem seneste shipping på user for ETO-klik checkout
  // næste gang kunden logger ind. Opdateres efter hver succesfuld ordre
  // hvis rememberAddress: true var sat i orders.create.
  shippingName    String?
  shippingAddress String?
  shippingZip     String?
  shippingCity    String?
  // Phase 4: telefonnummer for returnerende-kunde-lookup via mobil
  // (alternativ til email). Normaliseret format (+45XXXXXXXX eller blot 8 cifre).
  phoneNumber     String?

  carts         Cart[]
  orders        Order[]
  apiKeys       ApiKey[]
  accounts      Account[] // Auth.js v5 EmailProvider/OAuth kræver Account-tabel
  subscriptions Subscription[]
  // Phase 10 Slice 7: kunde-reviews skrevet mens logged-in (orderId+userId
  // = verified-purchase). Anonyme reviews via email-token har user=null.
  reviews       ProductReview[]
  wishlist      WishlistItem[]
  passwordResetTokens PasswordResetToken[]
  createdAt     DateTime        @default(now())
}

// Abandoned-cart idempotens (WooCommerce-paritet). cartId som PK = én mail pr.
// kurv. Mirror af ReviewPromptLog. Cron sender kun når ingen log-row findes.
model AbandonedCartLog {
  cartId         String   @id
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sentAt         DateTime @default(now())
  emailMessageId String?
}

// Ønskeliste (WooCommerce-paritet). Logged-in brugere. Unik pr. (userId, productId).
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Subscription {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String
  stripeSubId      String   @unique
  stripePriceId    String
  status           String // e.g. "active", "canceled", "past_due"
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean @default(false)
  pauseCollectionBehavior String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// Password-reset-tokens (token-baseret "glemt password"-flow). Vi gemmer KUN en
// HMAC-SHA256-hash af tokenet (peberet med AUTH_SECRET) — det rå token findes kun
// i reset-linket i emailen, så en DB-leak alene giver ingen brugbare reset-links.
// Single-use (usedAt) + kort TTL (expiresAt). Se lib/auth/password-reset.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Auth.js v5 standard-tabel. Krævet for EmailProvider (og fremtidige OAuth-
// providers). Eksisterende Credentials-users har ingen Account-rows; de
// oprettes automatisk ved første magic-link-verify.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Auth.js v5 magic-link verification-tokens. One-time-use, 15 min TTL.
model VerificationToken {
  identifier String // email
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Cart {
  id               String            @id @default(cuid())
  sessionId        String?           @unique
  userId           String?
  user             User?             @relation(fields: [userId], references: [id])
  items            CartItem[]
  abandonedCartLog AbandonedCartLog?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  // Task B variant-system: nullable for backwards-compat (produkter uden varianter).
  // To linjer med samme product men forskellige variantId må sameksistere i samme cart
  // — derfor inkluderer @@unique både product OG variant.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)

  // SQLite har ingen "NULLS NOT DISTINCT"-mulighed, så variantId=null deler
  // én row pr. (cart, product). Variant-produkter får én row pr. variantId.
  // Trade-off: man kan ikke have 2 cart-items med variantId=null for samme produkt
  // — men det er præcis hvad upsert har brug for (samme adfærd som før).
  @@unique([cartId, productId, variantId])
  @@index([variantId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  email           String
  status          String      @default("pending") // pending | paid | shipped | cancelled | refunded | partial_refund | disputed | flagged_review | pending_payment
  shippingName    String
  shippingAddress String
  shippingZip     String
  shippingCity    String
  // Ordrestyring (HPOS): valgfri separat faktura-adresse. null på ALLE felter
  // ⇒ "samme som leveringsadresse" (universel default). WooCommerce splitter
  // billing/shipping i en join-tabel; vi holder shipping inline (load-bearing
  // i createOrder/webhook/pakkeseddel/AI-tools) og tilføjer billing additivt.
  billingName     String?
  billingAddress  String?
  billingZip      String?
  billingCity     String?
  billingCountry  String?
  // Phase 4: telefonnummer for returnerende-kunde-lookup via mobil
  phoneNumber     String?
  subtotalDkk     Int
  shippingDkk     Int
  discountDkk     Int         @default(0)
  totalDkk        Int
  // Moms-andel af totalen (øre). Sættes ved ordre-oprettelse via lib/tax.ts
  // (eller af Stripe Tax når features.stripeTax). Null på ældre ordrer.
  vatOere         Int?
  // Faktura (lib/invoicing). Sættes når en faktura genereres for ordren.
  invoiceProvider String?
  invoiceId       String?
  invoicePdfUrl   String?
  discountCode    String?
  isAiGenerated   Boolean     @default(false)
  aiAgentSource   String?
  items           OrderItem[]
  // Shipping/fulfillment (Track G). Additivt nullable.
  carrier             String?
  trackingNumber      String?
  trackingUrl         String?
  estDeliveryFrom     DateTime?
  estDeliveryTo       DateTime?
  fulfillmentOrders   FulfillmentOrder[]
  createdAt       DateTime    @default(now())

  // Phase 2-prep: payment-felter for Phase 3 Stripe-integration.
  // I Phase 2 sætter mock-payment paymentMethod="mock" og paidAt=now().
  // I Phase 3 sættes stripePaymentIntentId ved create-intent og
  // paymentMethod/paidAt opdateres af webhook efter payment_intent.succeeded.
  stripePaymentIntentId String?
  paymentMethod         String? // "mock" | "stripe_card" | "stripe_mobilepay" | etc
  paidAt                DateTime?

  // Multi-currency (v0.15.0): presentment snapshot — WHAT the customer was
  // charged. The *Dkk columns above remain the canonical base-currency ledger;
  // these let receipts/refunds/exports reproduce the customer-facing amount.
  // Base-currency shops keep currency=base, fxRate=1 (set by createOrder).
  currency              String    @default("DKK")
  fxRate                Float     @default(1)

  // ACP (Agentic Commerce Protocol): channel sporer ordrens oprindelse,
  // acpSessionId linker tilbage til den AcpCheckoutSession der skabte den.
  channel      String  @default("web") // "web" | "chat" | "acp"
  acpSessionId String?

  // Phase 4: tracking for idempotent confirmation-email + refund/dispute.
  // confirmationEmailSentAt sikrer at webhook-retry ikke sender duplicate
  // mail. refundedAt + disputedAt sættes af charge.refunded / dispute.created.
  confirmationEmailSentAt DateTime?
  refundedAt              DateTime?
  disputedAt              DateTime?

  // Phase 10 Slice 7: link til reviews skrevet baseret på denne ordre
  // (orderId-link = verified-purchase markering på review).
  reviews         ProductReview[]
  reviewPromptLog ReviewPromptLog?

  // Ordrestyring (HPOS): noter/timeline + returneringer.
  notes   OrderNote[]
  returns Return[]

  // Indexes for orders.list filter-felter (review fund #7) — uden disse
  // laver Prisma fullscan på dato/email/status-filtre.
  @@index([createdAt])
  @@index([status])
  @@index([email])
}

// Ordrestyring (HPOS): WooCommerce-style ordre-noter — fungerer SAMTIDIG som
// status-timeline. Ét model frem for to parallelle tabeller (præcis som
// WooCommerce, hvor order notes ER timelinen):
//   type="system"  → auto-entry (status-skift, refund, tracking, email sendt)
//   type="private" → operatør intern note (admin-only; ingen "customer"-type
//                     da returneringer er admin-initierede i denne release)
// metaJson holder struktureret payload for system-entries: {from,to} ved
// status-skift, {amount} ved refund, {carrier,trackingNumber} ved tracking.
model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   @default("private") // "system" | "private"
  body      String
  // AuditActor-konvention: "user:<id>" | "system:<task>" | "stripe-webhook:system"
  author    String
  metaJson  String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// Ordrestyring (HPOS): admin-initieret retur/RMA. Ingen kunde-portal i denne
// release — en operatør registrerer returen og udsteder refund + restock fra
// ordre-workspace. restocked-boolean er idempotens-ankeret der sikrer at
// lager kun øges én gang (se lib/orders/restock.ts).
model Return {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // requested → approved → received → refunded → closed | rejected
  status         String       @default("requested")
  reason         String
  refundDkk      Int          @default(0) // faktisk refunderet for denne retur (øre)
  restocked      Boolean      @default(false)
  stripeRefundId String?
  createdBy      String       // AuditActor
  createdAt      DateTime     @default(now())
  items          ReturnItem[]

  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id          String    @id @default(cuid())
  returnId    String
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  // snapshot så en slettet produkt/variant stadig kan læses
  productName String
  variantId   String?

  @@index([returnId])
}

// Fremtidig hook (bevidst IKKE bygget i v1): en generisk OrderMeta(orderId,
// key,value) er WooCommerce's workaround for et skema man ikke kan ændre. Her
// ejer vi skemaet, så typed kolonner + OrderItem.variantAttributes(Json) er
// renere og type-sikre. Tilføj kun hvis et felt med ukendt-på-build-tid form
// nogensinde er nødvendigt (fx kunde-specifikke PO-numre i B2B).

// Phase 2-prep: Stripe webhook-idempotency. event.id som primary key så
// gentagne kald af samme event (Stripe garanterer at de fires mindst én
// gang, ofte 2-3 gange) ikke giver dobbelt-ordrer eller dobbelt-stock-
// decrement. Wrap status-update i INSERT ... ON CONFLICT DO NOTHING.
// Bliver først aktivt brugt i Phase 3 men oprettes nu så migrationen
// er sammen med resten af Stripe-felterne.
model ProcessedWebhookEvent {
  id        String   @id // Stripe event.id
  type      String // payment_intent.succeeded, etc
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ACP (Agentic Commerce Protocol) — checkout-session for agentic commerce.
// En ACP-session er stateless server-til-server (ChatGPT m.fl. har ingen
// cookie), så den holder line items direkte i et JSON-snapshot frem for at
// genbruge den cookie-bundne Cart. Se cartwright-acp-v0.2-spec.md.
model AcpCheckoutSession {
  id     String @id @default(cuid())
  // not_ready_for_payment | ready_for_payment | completed | canceled | expired
  status String @default("not_ready_for_payment")

  currency      String @default("dkk")
  // Snapshot: [{ productId, variantId?, slug, name, unitPriceDkk, quantity }]
  lineItemsJson String

  buyerEmail String?
  buyerName  String?
  buyerPhone String?

  shippingName      String?
  shippingAddress   String?
  shippingZip       String?
  shippingCity      String?
  shippingCountry   String?
  fulfillmentOption String?
  discountCode      String?

  subtotalDkk Int @default(0)
  shippingDkk Int @default(0)
  discountDkk Int @default(0)
  totalDkk    Int @default(0)

  // Sættes ved /complete — peger på den oprettede Order.
  orderId   String?  @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
}

// Idempotency for ACP /complete — agentens idempotency_key dedup'es, så en
// retry ikke skaber dobbelt-ordrer. Gemmer det tidligere svar til replay.
model AcpIdempotencyKey {
  key          String   @id
  sessionId    String
  responseJson String
  createdAt    DateTime @default(now())
}

// ─── UCP identity-linking — OAuth 2.0 Authorization Server (Hul D) ──────────
// Gated bag brand.features.ucpIdentityLinking. Lader en agentic-platform (fx
// Google/UCP) få Authorization-Code+PKCE-delegering til at handle på en brugers
// vegne. Se docs/HUL-D-UCP-IDENTITY-LINKING.md + lib/ucp/oauth.ts.

// Registreret OAuth-klient (RFC 7591 dynamic registration). Public clients
// (PKCE, ingen secret) er default; confidential clients gemmer en hashet secret.
model OAuthClient {
  id              String   @id @default(cuid()) // = client_id
  name            String
  // Eksakte redirect-URIs (JSON-array). Eksakt-match håndhæves (open-redirect-værn).
  redirectUris    String
  // "none" (public + PKCE) | "client_secret_basic" (confidential)
  tokenAuthMethod String   @default("none")
  clientSecretHash String? // kun confidential clients (HMAC-hash, aldrig plaintext)
  // Tilladte scopes for klienten (JSON-array). Request-scope skal være subset.
  scopes          String
  createdAt       DateTime @default(now())
}

// Engangs-authorization-code, kortlivet. Vi gemmer KUN code-hash'en (aldrig
// plaintext) + PKCE-challenge'en. consumedAt sætter single-use.
model OAuthAuthCode {
  codeHash      String    @id
  clientId      String
  userId        String
  redirectUri   String
  scope         String // mellemrum-separerede grantede scopes
  codeChallenge String // PKCE S256-challenge (base64url)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([expiresAt])
}

// Access- og refresh-tokens. Kun token-hash'en gemmes (bearer-værn ved DB-leak).
// Access-tokens peger på deres udstedende refresh (parentRefreshId), så en
// refresh-revoke cascader til alle dens access-tokens (RFC 7009-krav).
model OAuthToken {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  kind            String // "access" | "refresh"
  clientId        String
  userId          String
  scope           String
  // familyId bæres uændret gennem refresh-rotation → reuse-detection (RFC 9700
  // §4.14.2): genbrug af en allerede-roteret refresh dræber HELE familien.
  familyId        String    @default("")
  parentRefreshId String? // access → sin refresh (generation-cascade)
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([familyId])
  @@index([parentRefreshId])
  @@index([userId])
  @@index([expiresAt])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  productName       String // snapshot
  unitPriceDkk      Int // snapshot
  quantity          Int
  // Task B variant-snapshot: vi gemmer både ID-reference OG en snapshot af
  // sku + attributes så ordrer er læselige selvom variant slettes senere.
  // Nullable = ordrer fra produkter UDEN variants opfører sig som før.
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  variantSku        String? // snapshot — fx "panel-hegn-2x3-grey"
  variantAttributes Json? // snapshot — {height: "2m", width: "3m", color: "grå"}

  // Ordrestyring (HPOS): retur-linjer der refererer denne ordre-linje.
  returnItems ReturnItem[]

  // analytics.summary topProducts groupBy productId — index speeder det op
  @@index([productId])
}

model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // "percent" | "fixed"
  value      Int // procent (0-100) eller øre
  validUntil DateTime?
  usageLimit Int?
  usageCount Int       @default(0)
  active     Boolean   @default(true)
}

// ─── AI-first additions ──────────────────────────────────────────────────────

// API-keys for ekstern AI-adgang (Claude Desktop via MCP, REST-klienter).
// Selve nøglen vises kun én gang ved oprettelse — vi gemmer kun en SHA-256
// hash så stjålne DB-rækker ikke afslører funktionelle keys. Scopes er en
// JSON-array af scope-strings ("products:write", "orders:read", ...).
model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // menneske-læseligt label, fx "Claude Desktop"
  keyHash     String    @unique
  scopes      String // JSON-array af scope-strings
  description String? // optional uddybning fx "Agentic Commerce frontend token"
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Audit-log for alle tool-kald (skrive- og destruktive operationer).
// `beforeJson` snapshotter pre-state så audit.revert kan rulle ændringer tilbage.
// `actor` er typed prefix ("apikey:<id>" | "user:<id>" | "storefront-chat:<sid>").
model AuditLog {
  id             String   @id @default(cuid())
  actor          String
  tool           String // fx "products.create"
  argsJson       String
  beforeJson     String?
  afterJson      String?
  ok             Boolean
  errorMsg       String?
  requestId      String
  ip             String?
  userAgent      String?
  // Local-AI v2 + voice plan: stempler hvert tool-kald med hvilken AI-provider
  // der drev det (via lib/audit-context.ts AsyncLocalStorage). Eksisterende
  // rows er backfilled til provider="anthropic", modality="text".
  provider       String?
  model          String?
  modality       String? // "text" | "voice"
  sessionMinutes Float? // voice-sessioners varighed indtil dette kald
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([tool])
  @@index([actor])
  @@index([provider])
}

